---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a
  href={href}
  class="label group flex w-fit items-center gap-x-2 text-ink/55 transition-colors duration-200 ease-out hover:text-ink"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="size-3.5 fill-none stroke-current stroke-2 transition-transform duration-200 ease-out group-hover:-translate-x-0.5"
  >
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 5 12 12 19"></polyline>
  </svg>
  <slot />
</a>
