---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
  href: string;
  external?: boolean;
  underline?: boolean;
};

const {
  href,
  external,
  underline = true,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
  class={cn(
    "text-ink/70 transition-colors duration-200 ease-out hover:text-ink",
    underline &&
      "underline underline-offset-4 decoration-ink/20 hover:decoration-ink/60",
    className,
  )}
  {...rest}
>
  <slot />
</a>
