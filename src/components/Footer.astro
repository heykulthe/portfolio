---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import BackToTop from "@components/BackToTop.astro";
import { SITE, SOCIALS } from "@consts";

const themes = [
  {
    id: "light-theme-button",
    label: "Light theme",
    paths: [
      "M12 7a5 5 0 1 0 0 10a5 5 0 0 0 0-10",
      "M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42",
    ],
  },
  {
    id: "dark-theme-button",
    label: "Dark theme",
    paths: ["M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"],
  },
  {
    id: "system-theme-button",
    label: "System theme",
    paths: ["M2 4h20v13H2zM8 21h8M12 17v4"],
  },
];
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-16">
        <BackToTop />
      </div>
    </div>
    <div class="border-t pt-6 rule">
      <div class="flex flex-wrap items-center justify-between gap-y-4">
        <div class="label text-ink/55">
          &copy; {new Date().getFullYear()} {SITE.NAME}
        </div>
        <div class="flex items-center gap-x-5">
          {
            SOCIALS.map((social) => (
              <Link
                href={social.HREF}
                external
                underline={false}
                aria-label={`${SITE.NAME} on ${social.NAME}`}
                class="label text-ink/55 hover:text-ink"
              >
                {social.NAME}
              </Link>
            ))
          }
        </div>
        <div class="flex items-center gap-x-1">
          {
            themes.map((theme) => (
              <button
                id={theme.id}
                aria-label={theme.label}
                class="group flex size-7 items-center justify-center rounded-sm"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-ink/50 transition-colors duration-200 ease-out group-hover:text-ink"
                >
                  {theme.paths.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex justify-center pb-2 pt-16">

        <svg
          viewBox="0 0 1000 1000"
          role="img"
          aria-label="力, power"
          class="size-28 select-none fill-ink/20 sm:size-36"
        >
          <path d="M66.6 273.8 76.1 303.4H846.7V273.8ZM770.6 273.8C760.0 577.2 742.1 774.8 701.9 807.6C691.3 818.2 679.7 821.4 660.7 821.4C627.9 821.4 533.8 816.1 466.2 811.8V822.4C530.7 835.1 581.4 857.3 605.7 881.6C630.0 904.9 638.5 942.9 637.4 991.5C731.5 991.5 780.1 974.6 823.5 934.5C891.1 874.2 914.4 690.3 927.1 331.9C952.4 327.7 966.2 320.3 975.7 309.7L841.4 191.3L757.9 273.8ZM382.7 0.0C381.6 391.1 404.9 715.6 24.3 986.3L33.8 1000.0C555.0 789.6 542.3 446.1 550.7 48.6C577.2 45.5 587.7 35.9 589.9 19.0Z" />
        </svg>
      </div>
    </div>
  </Container>
</footer>
