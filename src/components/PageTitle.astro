---
type Props = {
  index?: string;
  title: string;
  description?: string;
};

const { index, title, description } = Astro.props;
---

<div class="animate space-y-3">
  {index && <div class="label text-ink/45">{index}</div>}
  <h1 class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
    {title}
  </h1>
  {
    description && (
      <p class="max-w-measure text-ink/70">{description}</p>
    )
  }
</div>
