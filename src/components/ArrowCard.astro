---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"projects">;
};

const { entry } = Astro.props;

const year = entry.data.date
  ? new Date(entry.data.date).getFullYear().toString()
  : null;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="group flex flex-col gap-1.5 border-b py-5 transition-colors duration-200 ease-out rule hover:border-ink/50"
>
  <div class="flex items-baseline justify-between gap-4">
    <span class="font-display text-xl text-ink transition-colors duration-200 ease-out group-hover:underline group-hover:underline-offset-4">
      {entry.data.title}
    </span>
    {year && <span class="label shrink-0 text-ink/45">{year}</span>}
  </div>
  <p class="text-ink/65">
    {entry.data.description}
  </p>
</a>
