---
import { dateRange } from "@lib/utils";

type Props = {
  company: string;
  role: string;
  dateStart: Date;
  dateEnd: Date | string;
};

const { company, role, dateStart, dateEnd } = Astro.props;
---

<div class="space-y-3">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-xl text-ink">{company}</h3>
    <span class="label text-ink/55">{dateRange(dateStart, dateEnd)}</span>
  </div>
  <div class="label text-ink/70">{role}</div>
  <slot />
</div>
