---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import WorkEntry from "@components/WorkEntry.astro";
import Section from "@components/Section.astro";
import Orderbook from "@components/Orderbook.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS, HONOURS } from "@consts";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf(),
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  }),
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-24">
      <section class="animate space-y-7">
        <div class="space-y-4">
          <h1 class="font-display text-5xl font-semibold leading-none tracking-tight text-ink sm:text-6xl">
            {SITE.NAME}
          </h1>
          <p class="label text-ink/55">
            {SITE.ROLE} &middot; {SITE.COMPANY} &middot; {SITE.LOCATION}
          </p>
        </div>

        <div class="max-w-measure space-y-5">
          <p>
            I&rsquo;m a software engineer at Juspay, where I work on payments
            infrastructure. Payouts, card transaction flows, and the
            deployment systems that keep all of it running.
          </p>
          <p>
            Outside of work I spend most of my time closer to the metal. I&rsquo;ve
            written a C compiler from scratch, a low latency orderbook in Rust,
            and an options pricing library in C++. Metal is what I keep coming back to.
          </p>
        </div>

        <div class="max-w-measure pt-2">
          <Orderbook />
        </div>
      </section>

      <Section index="01" title="Experience" href="/work" label="all work">
        <ul class="space-y-12">
          {
            work.map((entry) => (
              <li>
                <WorkEntry
                  company={entry.data.company}
                  role={entry.data.role}
                  dateStart={entry.data.dateStart}
                  dateEnd={entry.data.dateEnd}
                >
                  <article>
                    <entry.Content />
                  </article>
                </WorkEntry>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section index="02" title="Projects" href="/projects" label="all projects">
        <ul class="-mt-5 border-t rule">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </Section>

      <Section index="03" title="Honours">
        <ul class="space-y-4">
          {
            HONOURS.map((honour) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <span class="text-ink">
                  {honour.HREF ? (
                    <Link href={honour.HREF} external>
                      {honour.TITLE}
                    </Link>
                  ) : (
                    honour.TITLE
                  )}
                </span>
                <span class="label text-ink/55">{honour.DETAIL}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section index="04" title="Elsewhere">
        <div class="space-y-7">
          <p class="max-w-measure">
            If you want to talk about cool tech, hire me, or rant about how
            naive LLMs can sometimes be, email is the best way to reach me.
          </p>
          <ul class="space-y-3">
            <li class="flex items-baseline gap-x-6">
              <span class="label w-28 shrink-0 text-ink/50">email</span>
              <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
                {SITE.EMAIL}
              </Link>
            </li>
            {
              SOCIALS.map((social) => (
                <li class="flex items-baseline gap-x-6">
                  <span class="label w-28 shrink-0 text-ink/50">{social.NAME}</span>
                  <Link
                    href={social.HREF}
                    external
                    aria-label={`${SITE.NAME} on ${social.NAME}`}
                  >
                    {social.HREF.replace(/^https:\/\/(www\.)?/, "")}
                  </Link>
                </li>
              ))
            }
          </ul>
        </div>
      </Section>
    </div>
  </Container>
</PageLayout>
